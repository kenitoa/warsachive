FROM node:22.22.3-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY web/package.json ./web/package.json
COPY mobile/package.json ./mobile/package.json
COPY api/package.json ./api/package.json
RUN npm ci --ignore-scripts
COPY api ./api
COPY web/lib ./web/lib
COPY web/content/knowledge.json ./web/content/knowledge.json
RUN npm run typecheck --workspace @war-archive/api

FROM node:22.22.3-bookworm-slim AS runtime
ENV NODE_ENV=production ARCHIVE_API_HOST=0.0.0.0 ARCHIVE_API_PORT=4200 ARCHIVE_API_DB_PATH=/data/archive.sqlite ARCHIVE_API_EXPORT_DIR=/data/exports ARCHIVE_API_PRIVATE_STORAGE_DIR=/data/private ARCHIVE_KNOWLEDGE_FILE=/app/web/content/knowledge.json
WORKDIR /app
COPY --from=build /app/api/package.json /app/api/openapi.json ./api/
COPY --from=build /app/api/src ./api/src
COPY --from=build /app/api/migrations ./api/migrations
COPY --from=build /app/web/lib ./web/lib
COPY --from=build /app/web/content/knowledge.json ./web/content/knowledge.json
RUN mkdir /data && chown node:node /data
USER node
EXPOSE 4200
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=4s --start-period=20s CMD node -e "fetch('http://127.0.0.1:4200/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--experimental-strip-types", "api/src/server.ts"]
