{
  "name": "@war-archive/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content:sync": "node scripts/sync-content-index.mjs",
    "content:export": "node --experimental-strip-types scripts/generate-public-artifacts.mjs",
    "assets:generate": "node --experimental-strip-types scripts/generate-assets.mjs",
    "predev": "npm run content:sync && npm run content:export && npm run assets:generate",
    "dev": "next dev",
    "prebuild": "npm run content:sync && npm run content:export && npm run assets:generate",
    "build": "next build",
    "postbuild": "node scripts/normalize-rsc-paths.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app lib scripts --max-warnings 0",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs"
  },
  "dependencies": {
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
