    "build:android": "expo export --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~55.0.0",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "typescript": "^5.9.2"
  }
}
